    name: 'test_wikipedia_first_screen_SME_WIKI_001',
    body: {
      lang: 'python',
      code: '    def test_wikipedia_first_screen_SME_WIKI_001(self, request):\n' +
        '        """\n' +
        '        Verify the Wikipedia app launches and the Explore feed is visible.\n' +
        '\n' +
        '        Steps\n' +
        '        -----\n' +
        '        1. Obtain the driver injected by conftest (SDK) or local fixture.\n' +
        '        2. Wait for the Search bar to appear — confirms the feed screen loaded.\n' +
        '        3. Assert the Search bar hint text is "Search Wikipedia".\n' +
        '        4. Assert the Explore bottom-nav tab is present.\n' +
        '        5. Assert the feed RecyclerView is present.\n' +
        '        """\n' +
        '        # When run directly by pytest (not via Run_Local_Debugger_Wikipedia.py),\n' +
        '        # request.node.driver may not be set — skip gracefully in that case.\n' +
        '        if not hasattr(request.node, "driver") or request.node.driver is None:\n' +
        '            pytest.skip("No driver injected — run via Run_Local_Debugger_Wikipedia.py "\n' +
        '                        "or smoke/conftest.py")\n' +
        '        driver = request.node.driver\n' +
        '        session_id = driver.session_id\n' +
        '\n' +
        '        try:\n' +
        '            wait = WebDriverWait(driver, 20)\n' +
        '\n' +
        '            # Step 2 — wait for search container\n' +
        '            search_container = wait.until(\n' +
        '                EC.presence_of_element_located(\n' +
        '                    (AppiumBy.ID, self._SEARCH_CONTAINER_ID)\n' +
        '                )\n' +
        '            )\n' +
        '            assert search_container is not None, (\n' +
        '                "Search container not found — app may not have launched correctly"\n' +
        '            )\n' +
        '\n' +
        '            # Step 3 — assert search hint text\n' +
        '            search_hint = wait.until(\n' +
        '                EC.presence_of_element_located(\n' +
        '                    (AppiumBy.ANDROID_UIAUTOMATOR,\n' +
        `                     f'new UiSelector().text("{self._SEARCH_HINT_TEXT}")')\n` +
        '                )\n' +
        '            )\n' +
        '            actual_text = search_hint.text\n' +
        '            assert actual_text == self._SEARCH_HINT_TEXT, (\n' +
        `                f"Expected search hint '{self._SEARCH_HINT_TEXT}', got '{actual_text}'"\n` +
        '            )\n' +
        '\n' +
        '            # Step 4 — assert Explore bottom-nav tab\n' +
        '            explore_tab = wait.until(\n' +
        '                EC.presence_of_element_located(\n' +
        '                    (AppiumBy.ACCESSIBILITY_ID, self._EXPLORE_TAB_DESC)\n' +
        '                )\n' +
        '            )\n' +
        '            assert explore_tab is not None, "Explore tab not found in bottom navigation"\n' +
        '\n' +
        '            # Step 5 — assert feed RecyclerView loaded\n' +
        '            feed = wait.until(\n' +
        '                EC.presence_of_element_located(\n' +
        '                    (AppiumBy.ID, self._FEED_RECYCLER_ID)\n' +
        '                )\n' +
        '            )\n' +
        '            assert feed is not None, "Feed RecyclerView not found — feed may not have loaded"\n' +
        '\n' +
        '            print("PASS: Wikipedia first screen validated successfully")\n' +
        '            if _HAS_INITIALIZER:\n' +
        '                Initializer.update_session_status(\n' +
        '                    session_id, "passed", "Wikipedia first screen validated"\n' +
        '                )\n' +
        '\n' +
        '        except Exception as e:\n' +
        '            print(f"An error occurred: {e}")\n' +
        '            if _HAS_INITIALIZER:\n' +
        '                Initializer.update_session_status(\n' +
        '                    session_id, "failed",\n' +
        '                    f"Wikipedia first screen test failed: {e}"\n' +
        '                )\n' +
        '            raise\n' +
        '\n' +
        '        finally:\n' +
        '            if _HAS_INITIALIZER:\n' +
        '                session_url = Initializer.get_session_url(session_id)\n' +
        '            else:\n' +
        '                session_url = (\n' +
        '                    f"Dashboard: https://app-automate.browserstack.com"\n' +
        '                    f"/dashboard/v2/sessions/{session_id}"\n' +
        '                )\n' +
        '            print(f"Test session URL: {session_url}")\n'
    },
    identifier: 'test_wikipedia_first_screen_SME_WIKI_001',
    scope: 'test_wikipedia_first_screen_SME_WIKI_001',
