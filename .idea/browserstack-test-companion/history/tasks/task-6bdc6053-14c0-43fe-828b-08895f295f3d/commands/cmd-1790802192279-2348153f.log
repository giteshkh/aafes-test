int = wait.until(\n        EC.presence_of_element_located(\n            (AppiumBy.ANDROID_UIAUTOMATOR, 'new UiSelector().text("Search Wikipedia")')\n        )\n    )\n    actual = search_hint.text\n    assert actual == "Search Wikipedia", f"Expected 'Search Wikipedia', got '{actual}'"\n    print(f"PASS: search hint text = '{actual}'")\n\n    # Assert 3: Explore tab\n    explore_tab = wait.until(\n        EC.presence_of_element_located((AppiumBy.ACCESSIBILITY_ID, "Explore"))\n    )\n    assert explore_tab is not None, "Explore tab not found"\n    print("PASS: Explore tab present")\n\n    # Assert 4: feed RecyclerView\n    feed = wait.until(\n        EC.presence_of_element_located(\n            (AppiumBy.ID, "org.wikipedia.alpha:id/fragment_feed_feed")\n        )\n    )\n    assert feed is not None, "Feed RecyclerView not found"\n    print("PASS: Feed RecyclerView present")\n\n    print("\nALL ASSERTIONS PASSED")\n\n    # Mark session passed\n    import requests as req\n    req.put(\n        f"https://api.browserstack.com/automate/sessions/{session_id}.json",\n        json={"status": "passed", "reason": "Wikipedia first screen validated"},\n        auth=(USERNAME, ACCESS_KEY)\n    )\n\nexcept Exception as e:\n    print(f"FAIL: {e}")\n    import requests as req\n    req.put(\n        f"https://api.browserstack.com/automate/sessions/{session_id}.json",\n        json={"status": "failed", "reason": str(e)},\n        auth=(USERNAME, ACCESS_KEY)\n    )\n    sys.exit(1)\nfinally:\n    driver.quit()\nEOF
