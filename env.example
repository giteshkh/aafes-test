# env.example — copy this to .env and fill in your values
# The .env file is loaded automatically by all entry points via python-dotenv.
# .env is git-ignored — never commit real credentials.
# This file (env.example) IS committed so teammates know what to set.

# ── BrowserStack credentials ──────────────────────────────────────────────────
BROWSERSTACK_USERNAME=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key

# ── App under test ────────────────────────────────────────────────────────────
# Wikipedia sample (already uploaded — use this to verify infra first):
AppURL=bs://2cb25d26a5b87168117ec49799f3cc5e51756e61

# Customer's AAFES MEA app — replace with your uploaded bs:// URL:
# AppURL=bs://YOUR_AAFES_APP_URL_HERE

# ── proxyUnawareApp ───────────────────────────────────────────────────────────
# Set to true ONLY for the AAFES MEA app (which handles its own network stack).
# Leave as false (or unset) for the Wikipedia sample and other apps.
# Not all app/device combinations support this capability.
PROXY_UNAWARE_APP=false
# For AAFES app: PROXY_UNAWARE_APP=true

# ── Device / platform ─────────────────────────────────────────────────────────
PlatformType=android
DeviceName=Samsung Galaxy S23
DeviceVersion=13.0

# ── BrowserStack session metadata ─────────────────────────────────────────────
SESSION_NAME=test_wikipedia_sample
BUILD_NAME=MEA | Wikipedia | android

# ── AAFES app credentials (for test_keepmesignedin.py) ───────────────────────
APP_USERNAME=your_app_test_username
APP_PASSWORD=your_app_test_password